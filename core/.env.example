# --- Django Settings ---
DEBUG=False
SECRET_KEY=generate-a-secure-secret-key-for-production

# --- Networking ---
ALLOWED_HOSTS=example.com,www.example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com

# --- Database ---
# sqlite:///db.sqlite3 or postgres://user:password@host:port/dbname
DATABASE_URL=postgres://user:password@db-host:5432/db-name

# --- Security (Production Only) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- Static and Media Files ---
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# --- Social Auth - Google ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_SECRET=your-google-secret

# --- Email ---
# console://, smtp://user:password@host:port, or submission://user:password@host:port
EMAIL_URL=smtp://user:password@smtp.gmail.com:587
DEFAULT_FROM_EMAIL=noreply@example.com

# --- Logging ---
DJANGO_LOG_LEVEL=INFO
