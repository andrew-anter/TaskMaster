# --- Django Settings ---
DEBUG=True
# Required when DEBUG=False; a blank value is fine for local dev, where an
# ephemeral per-process key is generated (sessions/CSRF reset on restart).
# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# --- Networking ---
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Admin Notifications ---
ADMIN_EMAIL=admin@example.com
SERVER_EMAIL=root@example.com

# --- Database ---
# SQLite (default) or PostgreSQL
# sqlite:///db.sqlite3 or postgres://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Database connection settings (production only)
# DB_CONN_MAX_AGE=600
# DB_CONNECT_TIMEOUT=10

# --- Celery / Valkey (Redis-compatible broker) ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Run the task-reminder generation task every N seconds (default 900 = 15 min)
# CELERY_BEAT_REMINDERS_INTERVAL_SECONDS=900
# Set to True to run Celery tasks synchronously without a broker (dev without valkey)
# CELERY_TASK_ALWAYS_EAGER=True

# --- Notification Retention (enforced by the cleanup beat task) ---
# Keep read notifications for N days (default 30)
# NOTIFICATIONS_READ_RETENTION_DAYS=30
# Keep unread notifications for N days (default 90)
# NOTIFICATIONS_UNREAD_RETENTION_DAYS=90
# Run the notification cleanup task every N seconds (default 86400 = 24 h)
# CELERY_BEAT_NOTIFICATIONS_CLEANUP_INTERVAL_SECONDS=86400

# --- Security (Production Only) ---
# Uncomment for production:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# Trust the first X-Forwarded-For hop for login lockout keys. Only enable
# behind a reverse proxy that overwrites the header.
# TRUST_X_FORWARDED_FOR=True

# --- Session Configuration ---
SESSION_COOKIE_AGE=1209600
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# --- Static and Media Files ---
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# --- Cache Configuration (Production) ---
# CACHE_TIMEOUT=300
# Max entries per database cache table before old keys are culled
# CACHE_MAX_ENTRIES=10000
# Redis (or Valkey) for login lockout counters: their increments are atomic
# there, unlike the database cache fallback. Use a DB index apart from Celery's.
# REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# --- Social Auth - Google (Optional) ---
# Leave empty to disable Google login
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# --- Email (Production; loaded into Django's MAILERS setting) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=webmaster@localhost

# --- API Throttling ---
API_THROTTLE_ANON=100/hour
API_THROTTLE_USER=1000/hour

# --- Account Security ---
# allauth login_failed rate limits: per-IP and per-username/password pair
ACCOUNT_LOGIN_ATTEMPTS_LIMIT=10/m/ip,5/5m

# --- Logging ---
DJANGO_LOG_LEVEL=INFO
