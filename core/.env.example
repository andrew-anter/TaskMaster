# --- Django Settings ---
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production

# --- Networking ---
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Admin Notifications ---
ADMIN_EMAIL=admin@example.com
SERVER_EMAIL=root@example.com

# --- Database ---
# SQLite (default) or PostgreSQL
# sqlite:///db.sqlite3 or postgres://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Database connection settings (production only)
# DB_CONN_MAX_AGE=600
# DB_CONNECT_TIMEOUT=10

# --- Security (Production Only) ---
# Uncomment for production:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# --- Session Configuration ---
SESSION_COOKIE_AGE=1209600
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# --- Static and Media Files ---
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# --- Cache Configuration (Production) ---
# CACHE_TIMEOUT=300

# --- Social Auth - Google (Optional) ---
# Leave empty to disable Google login
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# --- Email (Production) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=webmaster@localhost

# --- API Throttling ---
API_THROTTLE_ANON=100/hour
API_THROTTLE_USER=1000/hour

# --- Account Security ---
ACCOUNT_LOGIN_ATTEMPTS_LIMIT=5/5m

# --- Logging ---
DJANGO_LOG_LEVEL=INFO
